{
  "name": "backend",
  "version": "1.0.0",
  "description": "this is backend for my fronteir project",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "dev": "nodemon -r dotenv/config --experimental-json-modules src/index.js",
    "migrate": "node -r dotenv/config src/migrations/runner.js up",
    "migrate:down": "node -r dotenv/config src/migrations/runner.js down 1",
    "migrate:status": "node -r dotenv/config src/migrations/runner.js status",
    "migrate:create": "node -r dotenv/config node_modules/migrate-mongo/bin/migrate-mongo.js create"
  },
  "author": "ANUJ YADAV",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "mysql2": "^3.19.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@types/jest": "^29.5.0",
    "@types/sinon": "^17.0.0",
    "@types/supertest": "^6.0.0",
    "babel-jest": "^30.5.1",
    "jest": "^29.7.0",
    "migrate-mongo": "^14.0.7",
    "nodemon": "^3.1.11",
    "sinon": "^17.0.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0"
  }
}
