NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:3000

# Generate new secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

ACCESS_TOKEN_SECRET=your_64_char_hex_secret_here
ACCESS_TOKEN_LIFE=1d
REFRESH_TOKEN_SECRET=your_64_char_hex_secret_here
REFRESH_TOKEN_LIFE=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# OAuth Encryption Key (32 chars for AES-256-GCM)
OAUTH_ENCRYPTION_KEY=your_32_char_encryption_key

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_USER=backend_app
MYSQL_PASSWORD=your_secure_password
MYSQL_DATABASE=backend
MYSQL_PORT=3306

REDIS_HOST=localhost
REDIS_PORT=6379